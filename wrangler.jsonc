{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clef-loop-canary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "ROUTE", "class_name": "RouteState" },
      { "name": "LABELS", "class_name": "Labels" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RouteState"] },
    { "tag": "v2", "new_sqlite_classes": ["Labels"] }
  ],
  "observability": { "enabled": true },
  // workers.dev is not in your zone, so zone WAF rules don't apply there. The bearer
  // token guards every route; for production, serve it on a Custom Domain or call it
  // through a service binding and set workers_dev to false.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "GATEWAY_ID": "clef-loop",
    // Base arm: Clef-flash on Workers AI (System One API).
    "BASE_ARM": "{\"kind\":\"systemone\",\"model\":\"@cf/cloudflare/clef-flash\"}",
    // Tuned arm. Empty means base only. Examples:
    //   Workers AI LoRA (public today):
    //     {"kind":"lora","model":"@cf/mistral/mistral-7b-instruct-v0.2-lora","lora":"<finetune name>","template":"mistral"}
    //   A BYOM deployment of a tuned Clef (needs BYOM access; the model id comes from Cloudflare):
    //     {"kind":"systemone","model":"<byom model id>","selector":"clef-flash"}
    "TUNED_ARM": "",
    // off | shadow (serve base, run tuned on the side) | canary (send CANARY_PERCENT to tuned)
    "MODE": "off",
    "CANARY_PERCENT": "10",
    // Changing this re-buckets keys and starts a fresh revert window.
    "ROUTE_VERSION": "v1",
    "TUNED_TIMEOUT_MS": "1500",
    // Tenants that opted in to capture, comma-separated. Only their requests are logged by
    // AI Gateway (collectLog: true per request); everyone else gets collectLog: false.
    // Every state is redacted before the call either way. Empty: nobody is captured.
    "CAPTURE_TENANTS": "",
    // State keys that look sensitive but carry no PII in your data, kept as-is.
    "REDACT_KEEP_KEYS": "",
    // Flag answers whose top probability is below this for a person to decide. Empty: off.
    "ABSTAIN_BELOW": "",
    // Revert the route when the 95% Wilson lower bound of tuned's failure rate over its
    // last 200 requests is above 1%, or above base's own rate over its last 200 if that is
    // higher (judged once 50 tuned requests are in). Failures include validator rejects.
    "REVERT_WINDOW": "200",
    "REVERT_MIN_SAMPLES": "50",
    "REVERT_MAX_FAILURE_RATE": "0.01"
  }
  // Secret: npx wrangler secret put CLEF_LOOP_TOKEN
}
